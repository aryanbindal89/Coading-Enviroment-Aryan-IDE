{
  "name": "aryan-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Aryan IDE desktop development environment",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --test",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.aryanide.desktop",
    "productName": "Aryan IDE",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": { "buildResources": "build", "output": "release" },
    "files": ["out/**/*", "extensions/**/*", "package.json"],
    "asarUnpack": ["node_modules/node-pty/**/*"],
    "win": { "target": ["nsis"], "artifactName": "Aryan-IDE-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
